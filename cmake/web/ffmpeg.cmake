# FFmpeg for the web build: the SDK's subset (libavutil + libavcodec for the
# XMA/WMA Pro decoder; thirdparty/CMakeLists.txt in the SDK, same lists) as
# portable C - no x86/ARM assembly. Included by trials_hd_web.cmake.
#
# FFmpeg is a nested submodule of the SDK, outside its patch, so its config
# is not edited: config.h is generated here from the Linux x86-64 one with
# every architecture feature off, and found first on the include path.

set(_ffmpeg ${_tp}/FFmpeg)
set(_ffmpeg_config_dir ${CMAKE_BINARY_DIR}/ffmpeg-web)
file(READ ${_ffmpeg}/config_linux_x86_64.h _ffmpeg_config)
string(REGEX REPLACE "#define ARCH_([A-Z0-9_]+) 1" "#define ARCH_\\1 0" _ffmpeg_config "${_ffmpeg_config}")
foreach(_feature AESNI AMD3DNOW AMD3DNOWEXT AVX AVX2 AVX512 FMA3 FMA4 MMX MMXEXT SSE SSE2 SSE3
                 SSE4 SSE42 SSSE3 XOP CPUNOP I686 FAST_CMOV INLINE_ASM ASM_TYPES_H EBP_AVAILABLE
                 EBX_AVAILABLE INLINE_ASM_DIRECT_SYMBOL_REFS INLINE_ASM_LABELS
                 INLINE_ASM_NONLOCAL_LABELS SYMVER_ASM_LABEL SYMVER_GNU_ASM XMM_CLOBBERS X86ASM
                 SIMD_ALIGN_32 SIMD_ALIGN_64
                 # Not in Emscripten's libc; FFmpeg falls back to sysconf().
                 SCHED_GETAFFINITY)
    string(REGEX REPLACE "#define HAVE_${_feature}((_INLINE|_EXTERNAL)?) 1"
           "#define HAVE_${_feature}\\1 0" _ffmpeg_config "${_ffmpeg_config}")
endforeach()
file(WRITE ${_ffmpeg_config_dir}/config.h.tmp
     "/* Generated by cmake/web/ffmpeg.cmake from config_linux_x86_64.h */\n${_ffmpeg_config}")
file(COPY_FILE ${_ffmpeg_config_dir}/config.h.tmp ${_ffmpeg_config_dir}/config.h ONLY_IF_DIFFERENT)
foreach(_list codec_list parser_list bsf_list)
    configure_file(${_tp}/ffmpeg-overlay/${_list}.c ${_ffmpeg_config_dir}/libavcodec/${_list}.c COPYONLY)
endforeach()

