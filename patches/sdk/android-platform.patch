diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..225ed02
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,44 @@
+// Fibers on Android: a guest thread may convert itself, and nothing else.
+// Bionic has no ucontext to switch stacks with, and this title creates no
+// guest fibers.
+
+#include <cstdlib>
+
+#include <rex/logging.h>
+#include <rex/thread/fiber.h>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* fiber = new Fiber();
+  fiber->is_thread_fiber_ = true;
+  tls_current_ = fiber;
+  return fiber;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  (void)stack_size;
+  (void)entry;
+  (void)arg;
+  REXSYS_CRITICAL("Guest fibers are not supported on Android");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  (void)target;
+  REXSYS_CRITICAL("Guest fibers are not supported on Android");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_ && tls_current_ == this) {
+    tls_current_ = nullptr;
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
