diff --git a/src/audio/xma_context.cpp b/src/audio/xma_context.cpp
--- a/src/audio/xma_context.cpp
+++ b/src/audio/xma_context.cpp
@@ -690,8 +690,12 @@ void XmaContext::Decode(XMA_CONTEXT_DATA* data) {
   const int16_t packet_index = GetPacketNumber(current_input_size, data->input_buffer_read_offset);

   if (packet_index == -1) {
-    REXAPU_ERROR("XmaContext {}: Invalid packet index. Input read offset: {}", id(),
-                 static_cast<uint32_t>(data->input_buffer_read_offset));
+    // The offset is past this buffer. Leaving it there makes every later
+    // callback log and return, which stalls the mixer on one packet.
+    REXAPU_WARN(
+        "XmaContext {}: read offset {} is past the input buffer ({} bytes); swapping",
+        id(), static_cast<uint32_t>(data->input_buffer_read_offset), current_input_size);
+    SwapInputBuffer(data);
     return;
   }
