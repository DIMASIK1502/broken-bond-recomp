diff --git a/src/core/perf/counter.cpp b/src/core/perf/counter.cpp
index 536009e..eadde85 100644
--- a/src/core/perf/counter.cpp
+++ b/src/core/perf/counter.cpp
@@ -179,4 +179,20 @@ void FlushCsv() {
   g_csv_path.clear();
 }
 
+std::atomic<int64_t> g_presented_dt_us{0};
+std::atomic<uint64_t> g_presented_serial{0};
+
+void NotePresentedFrame(int64_t dt_us) {
+  g_presented_dt_us.store(dt_us, std::memory_order_relaxed);
+  g_presented_serial.fetch_add(1, std::memory_order_release);
+}
+
+int64_t GetPresentedFrameDtUs() {
+  return g_presented_dt_us.load(std::memory_order_relaxed);
+}
+
+uint64_t GetPresentedFrameSerial() {
+  return g_presented_serial.load(std::memory_order_acquire);
+}
+
 }  // namespace rex::perf
