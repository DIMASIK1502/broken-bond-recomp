diff --git a/src/core/fiber_emscripten.cpp b/src/core/fiber_emscripten.cpp
new file mode 100644
index 0000000..c456f79
--- /dev/null
+++ b/src/core/fiber_emscripten.cpp
@@ -0,0 +1,43 @@
+// Fibers on the web: a guest thread may convert itself, and nothing else.
+// Switching stacks would require Asyncify on every recompiled function.
+
+#include <cstdlib>
+
+#include <rex/logging.h>
+#include <rex/thread/fiber.h>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* fiber = new Fiber();
+  fiber->is_thread_fiber_ = true;
+  tls_current_ = fiber;
+  return fiber;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  (void)stack_size;
+  (void)entry;
+  (void)arg;
+  REXSYS_CRITICAL("Guest fibers are not supported on the web");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  (void)target;
+  REXSYS_CRITICAL("Guest fibers are not supported on the web");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_ && tls_current_ == this) {
+    tls_current_ = nullptr;
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
