+void XmaContext::EmitSplitFrame(XMA_CONTEXT_DATA* data) {
+  std::memcpy(input_buffer_.data(), split_saved_.data(), kBytesPerPacketData);
+  std::memcpy(input_buffer_.data() + kBytesPerPacketData,
+              GetCurrentInputBuffer(data) + kBytesPerPacketHeader, kBytesPerPacketData);
+
+  const uint32_t frame_size = split_frame_size_;
+  const uint32_t relative_offset = split_relative_offset_;
+  const uint32_t bits_in_first = kBitsPerPacket - relative_offset;
+  const uint32_t bits_from_second = frame_size > bits_in_first ? frame_size - bits_in_first : 0;
+  split_hold_ = false;
+  split_since_ms_ = 0;
+  split_nudge_ms_ = 0;
+
+  BitStream stream(input_buffer_.data(), (kBitsPerPacket - kBitsPerPacketHeader) * 2);
+  stream.SetOffset(relative_offset - kBitsPerPacketHeader);
+  xma_frame_.fill(0);
+  const uint32_t padding_start = static_cast<uint8_t>(stream.Copy(xma_frame_.data() + 1, frame_size));
+  decoded_frame_.fill(0);
+
+  if (PrepareDecoder(data->sample_rate, bool(data->is_stereo)) == 1) {
+    carry_valid_ = false;
+  }
+  PreparePacket(frame_size, padding_start);
+  const bool decoded = DecodePacket(av_context_, av_packet_, av_frame_);
+  if (decoded) {
+    ConvertFrame(reinterpret_cast<const uint8_t**>(&av_frame_->data), bool(data->is_stereo),
+                 decoded_frame_.data());
+    const size_t pad_bytes = kDecoderStartPadding * kBytesPerSample << data->is_stereo;
+    const size_t carry_bytes = (kBytesPerFrameChannel << data->is_stereo) - pad_bytes;
+    if (carry_valid_) {
+      std::memcpy(raw_frame_.data(), carry_frame_.data(), carry_bytes);
+      std::memcpy(raw_frame_.data() + carry_bytes, decoded_frame_.data(), pad_bytes);
+      current_frame_remaining_subframes_ = 4 << data->is_stereo;
+      loop_frame_output_limit_ = pending_output_limit_;
+      current_frame_remaining_subframes_ -=
+          std::min(pending_start_skip_, current_frame_remaining_subframes_);
+    }
+    std::memcpy(carry_frame_.data(), decoded_frame_.data() + pad_bytes, carry_bytes);
+    carry_valid_ = true;
+    pending_output_limit_ = 0;
+    pending_start_skip_ = 0;
+  } else {
+    carry_valid_ = false;
+  }
+
+  const uint32_t packet_frame_offset = xma::GetPacketFrameOffset(GetCurrentInputBuffer(data));
+  const uint32_t spill_end = kBitsPerPacketHeader + bits_from_second;
+  // The packet header names the first frame that begins in this buffer. That
+  // is the resume point when it sits at or past the spilled tail. A smaller
+  // value would decode the spill again.
+  data->input_buffer_read_offset = packet_frame_offset >= spill_end ? packet_frame_offset : spill_end;
+}
