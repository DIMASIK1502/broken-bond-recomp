+// naga declares push constants as var<immediate>, which plume-web rewrites to
+// the uniform buffer at group 3 binding 999. The PC cache leaves this unset.
+static bool ConvertSpirvToWgsl(const void* spirv, size_t spirvSize, uint64_t hash, const std::string& naga,
+                               std::vector<uint8_t>& wgsl)
