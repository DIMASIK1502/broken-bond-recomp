+    return false;
+#else
+    const auto directory = std::filesystem::temp_directory_path();
+    const auto spirvPath = directory / fmt::format("bb-{:016X}.spv", hash);
+    const auto wgslPath = directory / fmt::format("bb-{:016X}.wgsl", hash);
+    const auto logPath = directory / fmt::format("bb-{:016X}.log", hash);
+    writeAllBytes(spirvPath.string().c_str(), spirv, spirvSize);
+
+    SECURITY_ATTRIBUTES inherit{};
+    inherit.nLength = sizeof(inherit);
+    inherit.bInheritHandle = TRUE;
+    HANDLE log = CreateFileA(logPath.string().c_str(), GENERIC_WRITE, FILE_SHARE_READ, &inherit, CREATE_ALWAYS,
+                             FILE_ATTRIBUTE_TEMPORARY, nullptr);
+    std::string command = fmt::format("\"{}\" --input-kind spv --keep-coordinate-space \"{}\" \"{}\"", naga,
+                                      spirvPath.string(), wgslPath.string());
+    STARTUPINFOA startup{};
+    startup.cb = sizeof(startup);
+    startup.dwFlags = STARTF_USESTDHANDLES;
+    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    startup.hStdOutput = log;
+    startup.hStdError = log;
+    PROCESS_INFORMATION process{};
+    const BOOL started = log != INVALID_HANDLE_VALUE &&
+                         CreateProcessA(nullptr, command.data(), nullptr, nullptr, TRUE, CREATE_NO_WINDOW, nullptr,
+                                        nullptr, &startup, &process);
+    DWORD code = 1;
+    if (started) {
+        WaitForSingleObject(process.hProcess, INFINITE);
+        GetExitCodeProcess(process.hProcess, &code);
+        CloseHandle(process.hThread);
+        CloseHandle(process.hProcess);
+    }
+    if (log != INVALID_HANDLE_VALUE) CloseHandle(log);
+
+    std::string text;
+    if (started && code == 0 && std::filesystem::exists(wgslPath)) {
+        size_t wgslSize = 0;
+        auto wgslBytes = readAllBytes(wgslPath.string().c_str(), wgslSize);
+        text.assign(reinterpret_cast<const char*>(wgslBytes.get()), wgslSize);
+        const auto rewrite = [](std::string& value, const std::string& from, const std::string& to) {
+            for (size_t at = 0; (at = value.find(from, at)) != std::string::npos; at += to.size())
+                value.replace(at, from.size(), to);
+        };
+        rewrite(text, "var<immediate>", "@group(3) @binding(999) var<uniform>");
+        rewrite(text, "var<push_constant>", "@group(3) @binding(999) var<uniform>");
+    }
+    std::filesystem::remove(spirvPath);
+    std::filesystem::remove(wgslPath);
+
+    if (!started || code != 0 || text.empty() || text.find("binding_array") != std::string::npos) {
+        fmt::print(stderr, "WGSL conversion failed for {:016X}\n", hash);
