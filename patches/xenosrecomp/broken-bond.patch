+            fwrite(logBytes.get(), 1, logSize, stderr);
+            std::filesystem::remove(logPath);
+        }
+        return false;
+    }
+    std::filesystem::remove(logPath);
+    wgsl.assign(text.begin(), text.end());
+    return true;
+#endif
